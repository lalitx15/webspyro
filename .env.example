# =====================================================================
# WEBSPYRA — Environment Variables Configuration Template
# Copy this file to `.env.local` for local development
# =====================================================================

# 1. Supabase (Database, Auth, Storage & Realtime)
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Razorpay Payment Gateway (Checkout & Webhooks)
# Found in Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Email Delivery (Order notifications & lead alerts via Resend)
# Found in https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
CONTACT_NOTIFICATION_EMAIL=admin@webspyra.com

# 4. Canonical Site URL
# Local: http://localhost:3000 | Production: https://webspyra.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Optional Analytics & Tracking (Configurable also in Admin > SEO)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
